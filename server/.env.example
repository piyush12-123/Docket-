# Express Server Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/docket?retryWrites=true&w=majority

# JWT Secret Key
JWT_SECRET=super-secret-jwt-key-change-in-production-12345

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# OpenAI API Key for Vision & Document Intelligence
OPENAI_API_KEY=sk-proj-your-openai-api-key

# SMTP Server Credentials (Optional - for expiry email notifications)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="Docket Alerts" <alerts@docket.app>

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173
